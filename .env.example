# ─── Required ────────────────────────────────────────────────────────────────
# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Image generation (optional) ─────────────────────────────────────────────
# Default is "pollinations" — free, no key required.
# Set to "openai" to use DALL-E 3 (higher quality, costs credits).
# IMAGE_PROVIDER=pollinations
# IMAGE_PROVIDER=openai

# Required only when IMAGE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
